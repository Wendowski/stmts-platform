{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stmts.example/schemas/content-v0.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dialect",
    "blocks",
    "plainText",
    "excerpt",
    "readingMinutes",
    "isShort",
    "validationErrors"
  ],
  "properties": {
    "dialect": {
      "const": "stmts-md/1"
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "plainText": {
      "type": "string"
    },
    "excerpt": {
      "type": "string",
      "maxLength": 280
    },
    "readingMinutes": {
      "type": "integer",
      "minimum": 1
    },
    "isShort": {
      "type": "boolean"
    },
    "validationErrors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "text",
        "children"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "paragraph",
            "heading",
            "list",
            "orderedList",
            "item",
            "quote",
            "table",
            "tableHead",
            "tableBody",
            "row",
            "headerCell",
            "cell",
            "code",
            "rule",
            "text",
            "codeInline",
            "strong",
            "emphasis",
            "strike",
            "link",
            "span"
          ]
        },
        "text": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "start": {
          "type": "integer"
        },
        "url": {
          "type": "string",
          "pattern": "^(https?://|mailto:)"
        },
        "language": {
          "type": "string"
        },
        "sourceSpan": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    }
  }
}
